# ---- LLM 配置（兼容 OpenAI 接口，mcp_server 从这些环境变量读取）----
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# ---- Embedding 配置 ----
# 默认 API 模式（EMBEDDING_LOCAL=false），适合服务器/云主机：镜像更小、构建更快。
# 若改为 true（本地 sentence-transformers，镜像大），需在构建镜像时传 --build-arg EMBEDDING_LOCAL=true。
# 本地模式建议开启 HF_HUB_OFFLINE=1 并预置 models/<model名>/ 本地模型目录，彻底断开 HuggingFace 联网。
EMBEDDING_LOCAL=true
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 离线加载：模型已缓存到 <repo>/models/bge-large-zh-v1.5/（LocalEmbeddings 自动优先本地路径），不再联网。
HF_HUB_OFFLINE=1
# FastEmbed 稀疏(BM25)模型缓存定死到项目本地 <repo>/models/fastembed_cache/
FASTEMBED_CACHE_PATH=C:/Users/makot/Desktop/Ariadne/models/fastembed_cache

# ---- 运行时可选（不填则用默认值）----
# 图谱目录（图谱库）：面板会列出该目录下所有图谱供切换。默认取 ARIADNE_YAML 所在目录，
# 都没有则用 ./data。auth.json / operations.log / ariadne.log / retrieval_params.yaml
# 都按这个目录存放，所以库内切换图谱不会影响登录与参数。
# ARIADNE_GRAPHS_DIR=/app/data
# ARIADNE_YAML=/app/data/memory_graph.yaml   # 初始图谱：仅当没有历史记录时作为启动提示
# ARIADNE_PORT=8766          # MCP 容器内端口（内部容器访问用，通常不发布到宿主）
# ARIADNE_VIZ_PORT=8765      # 3D 可视化面板对外端口（外部浏览器访问）
# ARIADNE_OPLOG=/app/data/operations.log   # 操作日志路径（MCP+3D面板共用），默认 <图谱目录>/operations.log
# ARIADNE_LOG_FILE=/app/data/ariadne.log   # 跨进程服务日志（MCP 等写入，WebUI 面板聚合展示），默认 <图谱目录>/ariadne.log
# ARIADNE_LOG_LEVEL=INFO                   # 服务日志级别（写入共享日志文件，默认 INFO）
# ARIADNE_GRAPH_POLL=3                     # MCP 轮询图谱切换请求的间隔秒数（默认 3）

# 用哪份图谱由「共享指针」决定：面板里选定的图谱会记进 <图谱目录>/active_graph.json，
# 面板与 MCP 重启后都优先回到它；指针不存在（首次）才回落到 ARIADNE_YAML，再回落到
# 目录内的空图谱占位文件 sample_graph.yaml。因此日常换图谱直接在被面板里操作即可，
# 不需要改这里的配置或重启。

# ---- 面板 / MCP SSE 鉴权 ----
# 鉴权始终开启，账号密码存在 <图谱目录>/auth.json（只存随机盐 + PBKDF2 散列，
# 不可逆）。首次启动自动创建默认账号 ariadne / ariadne，并要求首次登录后修改密码。
#
# 下面两个环境变量是「忘记密码」时的重置后门：用它登录后可重设密码，改完建议删除。
# 它不是日常校验凭据——凭据以 auth.json 为准。
ARIADNE_VIZ_USER=admin
ARIADNE_VIZ_PASS=please-change-me

# 可选 pepper：参与密码散列，只存在环境里、不落盘；auth.json 泄漏也无法离线爆破。
# 注意：设置后不要随意更改，否则原密码无法校验（需用上面的重置后门重设密码）。
# ARIADNE_AUTH_KEY=

# MCP SSE 可选的非浏览器凭据（Authorization: Bearer <token>），与账号密码可并存
# ARIADNE_MCP_TOKEN=change-me-too

# 会话 Cookie 签名密钥（留空则自动生成并保存为 <图谱目录>/.ariadne_secret）
# ARIADNE_SECRET_KEY=

# ---- 独立 judge / reply 模型（评测用；留空则回退 OPENAI_*）----
# 说明：judge 与回复模型同源会放大自偏好（评分天花板/无区分度）。
# 建议 judge 用独立模型（如 GPT-4o / Qwen-Max / 豆包 等）以消除同源偏置；reply 可选。
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_API_BASE=
REPLY_MODEL=
REPLY_API_KEY=
REPLY_API_BASE=

# ---- ALM 专项服务（ariadne-alm / docker-compose.alm.yml）----
# ALM_HOST=0.0.0.0
# ALM_PORT=8770
# ALM_DATA_DIR=data/alm             # 各 user_id 的记忆文件与索引目录
# ALM_API_KEYS=key1,key2            # X-Api-Key 或 Authorization: Bearer/Token；留空则不鉴权
# ALM_SEARCH_SHAPE=hybrid           # raw 只出原子节点 / story 只出叙述 / hybrid 叙述+节点
# ALM_RERANK_MODE=tiered            # off / embedding / tiered / llm
# ALM_ABSTAIN_COS=0.35              # 硬下限：候选最大余弦低于它直接返回空数组
# ALM_ABSTAIN_VERIFY_HI=0.50        # 模糊带上限：低于它多调一次 LLM 判定「片段够不够回答问题」；与上一项一并置 0 才整体关闭弃权
# ALM_ABSTAIN_JUDGE_TOP_N=3         # 上述判定喂给 LLM 的片段条数（实测 3 已饱和）
# ALM_RERANK_POOL_RESERVE=20        # 候选池中预留给 T3 救援 / T4 时序的名额，避免被 T1/T2 整段挤掉
# ALM_FALLBACK_MAX_NODES=256        # 兜底落库条数上限，须 ≥ ALM_MAX_MESSAGES_PER_ADD
# ALM_RENDER_TIMESTAMPS=0           # 1 让叙事带上「记录于 YYYY-MM-DD」并切到带规则 9 的 prompt；默认 0
# ALM_PRICE_INPUT_PER_M=0.15        # token 计价的 input 单价（USD/百万 token），默认 gpt-4o-mini 官方价
# ALM_PRICE_OUTPUT_PER_M=0.60       # token 计价的 output 单价，本地用其它模型时按供应商价目表覆盖
# ALM_TOKEN_VERBOSE=1               # 1 每次 LLM 调用打一行 token 日志；0 只保留退出时的汇总
