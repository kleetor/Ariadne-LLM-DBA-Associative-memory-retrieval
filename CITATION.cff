    website: "https://github.com/kleetor"
version: 0.1.2
date-released: 2026-10-20
url: "https://github.com/kleetor/Ariadne-LLM-DBA-Associative-memory-retrieval"
repository-code: "https://github.com/kleetor/Ariadne-LLM-DBA-Associative-memory-retrieval"
license: AGPL-3.0-only
keywords:
  - llm
  - memory
  - knowledge-graph
  - retrieval
  - mcp
  - agent-memory
