# Ariadne ALM — 对外服务配置示例
#
# ---- 服务 ----
# 容器内监听端口。compose 的端口映射与容器内监听共用同一个值。
ALM_PORT=8770
# 记忆落盘目录（容器内固定 /data，由 compose 挂到具名卷 alm-data）。
ALM_DATA_DIR=/data

# ---- 鉴权（公网部署必填）----
# 对外提供服务的 API Key：客户端用 `X-Api-Key` 或 `Authorization: Bearer <key>` 携带；
# 多个 Key 用英文逗号分隔。
# ⚠️ 监听非回环地址时若为空，服务**拒绝启动**（不是放行所有请求）。
ALM_API_KEYS=change-me-to-a-strong-random-key

# ---- LLM（链路内部的维护 / 判定调用，必填）----
# 兼容 OpenAI 接口的端点（需支持 Chat Completions）。
OPENAI_MODEL=
OPENAI_API_KEY=gpt-4o-mini
OPENAI_API_BASE=

# ---- Embedding（向量化，必填）----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# 是否使用本地向量模型。容器一律走 API embedding；仅当镜像构建期预置了本地模型时才置 true。
EMBEDDING_LOCAL=false

# ---- 可选：按需开启 ----
# 给「纯向量通道」叠加 cross-encoder 重排（默认关闭）。
# 复用上面 Embedding 的端点与密钥，端点路径为 {base}/rerank。
ALM_RERANK=1
ALM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
