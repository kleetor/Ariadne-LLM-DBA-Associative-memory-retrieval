# Ariadne ALM — 对外服务配置示例
#
# ---- 服务 ----
# 容器内监听端口。compose 的端口映射与容器内监听共用同一个值。
ALM_PORT=8770
# 记忆落盘目录（容器内固定 /data，由 compose 挂到具名卷 alm-data）。
ALM_DATA_DIR=/data

# ---- 鉴权（公网部署必填）----
# 对外提供服务的 API Key：客户端用 `X-Api-Key` 或 `Authorization: Bearer <key>` 携带；
# 多个 Key 用英文逗号分隔。
# ⚠️ 监听非回环地址时若为空，服务**拒绝启动**（不是放行所有请求）。
ALM_API_KEYS=change-me-to-a-strong-random-key

# ---- LLM（链路内部的维护 / 判定调用，必填）----
# 兼容 OpenAI 接口的端点（需支持 Chat Completions）。
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_API_BASE=

# ---- Embedding（向量化，必填）----
# 端点需兼容 {base}/embeddings（OpenAI 格式，input 支持字符串数组）。
# 已实测可替换的两种（默认维度均为 1024、均返回单位向量，索引口径一致）：
#   · BAAI/bge-m3          + https://api.siliconflow.cn/v1
#   · text-embedding-v4    + https://maas.qianwenaiapi.com/compatible-mode/v1
# 换模型后空间索引指纹（含模型名）变化，旧索引会自动重建；但**不同模型的向量不可混用**，
# 若卷里已有数据，需接受重建成本或先重置数据。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# 是否使用本地向量模型。容器一律走 API embedding；仅当镜像构建期预置了本地模型时才置 true。
EMBEDDING_LOCAL=false
# 单请求最多几条 input。text-embedding-v4（compatible-mode）上限为 **10**；
# bge-m3 等可放宽（如 64）以减少请求次数。默认 10 对两者都安全。
EMBEDDING_MAX_BATCH=10

# ---- 可选：按需开启 ----
# 给「纯向量通道」叠加 cross-encoder 重排（默认关闭）。
# 与 Embedding 同供应商时可省略下面两项（自动沿用 EMBEDDING_API_BASE / KEY）。
# ⚠️ 两者供应商不同时（如 embedding 换 v4、rerank 仍用 SiliconFlow）必须**两个都填**，
#    否则 rerank 会跟着走新端点，而新端点没有该模型，重排会静默退化为原序。
ALM_RERANK=1
ALM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
ALM_RERANK_API_BASE=
ALM_RERANK_API_KEY=

# ---- 建图 / 回补（以下均有代码默认值，列在这里便于统一调参）----
# 归属判定：第 N 题到达后判定一次并冻结（默认 1；设 2 会牺牲只被问一次的空间）
ALM_FORCE_MODE=auto
ALM_ROUTE_PROBE_QUESTIONS=1
ALM_ROUTE_MIN_P=0.5
ALM_ROUTE_SAMPLE_CHARS=700

# 回补建图：判定前落在原文层的语料在后台补建进图
ALM_BACKFILL=1
ALM_BACKFILL_SLOTS=8
ALM_BACKFILL_BATCH_SIZE=24
ALM_BACKFILL_MAX_CHARS=8000
# 单组回补的耗时估算（秒），用于预算闸门
ALM_BACKFILL_GROUP_SECONDS=5

# 等待窗（单位：一次检索请求）与预算闸门（预测建图分钟数）
# 等待窗按"每题 10 分钟"计，同一空间可用多题累积；闸门只作成本护栏
ALM_GRAPH_WAIT=600
ALM_GRAPH_MAX_PRED_MIN=30
# 向量兜底后放弃回补：连续落空达到该次数才真正放弃（0 = 永不放弃）
ALM_ABANDON_AFTER_MISSES=3

# 出站节流（字符/分；0 = 关闭；遇 429 自动减半）
# 与 8 槽位匹配：约 267 次/分 × 5.5k 字符 ≈ 1.5M 字/分
ALM_EMBED_CHARS_PER_MIN=600000
ALM_LLM_CHARS_PER_MIN=1500000
ALM_RERANK_CHARS_PER_MIN=900000
ALM_THROTTLE_MAX_WAIT=120

# 返回量与重排候选
ALM_SEARCH_MAX_ITEMS=25
ALM_RERANK_CANDIDATES=25

# ---- 余弦阈值（与 embedding 模型强绑定，换模型必须重标）----
# 下列是 bge-m3 的标定值；text-embedding-v4 的余弦整体下移 0.03~0.05，应用 0.28 / 0.90。
# 依据：eval/probe_threshold_retune.py + data/dba_eval 的 70 条 gold 查询。
ALM_PURPOSE_FILTER_THRESHOLD=0.30
ALM_GRAPH_DEDUP_THRESHOLD=0.92
