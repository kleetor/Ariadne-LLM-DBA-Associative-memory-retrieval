# Ariadne quickstart configuration
# Copy this file to .env and fill in your own keys.

# ---- LLM (OpenAI-compatible) ----
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash
OPENAI_THINKING=0

# ---- Embedding (API mode; the launcher does not install torch) ----
EMBEDDING_LOCAL=false
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- Optional runtime settings ----
# ARIADNE_VIZ_PORT=8765
# ARIADNE_PORT=8766
# ARIADNE_YAML=./data/memory_graph.yaml
# ARIADNE_MCP_TOKEN=
